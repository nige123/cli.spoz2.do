use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use SPOZ2Test;

plan 12;

my $dir = temp-dir;

my ($rc, $out, $err) = spoz2($dir, 'check');
is $rc, 1, 'check without SPOZ2 exits 1';
is $err, "No SPOZ2 found in this directory or its parents.\nRun 'spoz2 init' to create one.\n", 'actionable message';

($rc, $out, $err) = spoz2($dir, 'init');
is ($rc, $out), (0, "Created SPOZ2\n"), 'init output';
($rc, $out, $err) = spoz2($dir, 'init');
is $rc, 1, 'second init fails';
like $err, /'already exists'/, 'second init explains';

($rc, $out, $err) = spoz2($dir, 'check');
is $rc, 1, 'placeholder gist fails check';
like $out, /^ 'SPOZ2:' \d+ ': gist is still the placeholder' /, 'check reports line';

($rc, $out, $err) = spoz2($dir, 'add', 'gist', 'A CLI test.');
is $out, "Set gist.\n", 'add gist output';
($rc, $out, $err) = spoz2($dir, 'add', 'invariant', 'Always.');
is $out, "Added invariant.\n", 'add invariant output';
($rc, $out, $err) = spoz2($dir, 'check');
is ($rc, $out), (0, "OK SPOZ2\n"), 'check passes';

# explicit .spoz2 file from a nested directory
my $nested = $dir.add('docs');
$nested.mkdir;
$nested.add('security.spoz2').spurt("SPOZ2 0.1\n\ngist:\n    Security intent.\n\ninvariants:\n    - Secrets never logged.\n");
($rc, $out, $err) = spoz2($nested, 'check', 'security.spoz2');
is ($rc, $out), (0, "OK security.spoz2\n"), 'explicit .spoz2 checked';
($rc, $out, $err) = spoz2($nested, 'show', 'security.spoz2', 'invariants');
is $out, "- Secrets never logged.\n", 'show section of explicit .spoz2';
