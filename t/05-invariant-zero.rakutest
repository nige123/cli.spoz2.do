# Copyright Nige Ltd. Author: Nigel Hamilton.
# Invariant zero under the in-development format 0.0: inheritance,
# canonical-text verification and accurate check reporting.  A digest
# identifies the adopted text; nothing here claims that stating or hashing
# a rule makes software obey it - these tests pin what the TOOL verifies.
use Test;
use lib 'lib';
use SPOZ2::Document;

plan 12;

my $g = "gist:\n    hi\n";

# --- inheritance: omitting the text removes nothing ----------------------
my $inherit = SPOZ2::Document.parse("SPOZ2 0.0\n\n$g\ninvariants:\n    - Something project-specific.\n");
ok $inherit.ok, 'a file without the text has no errors';
nok $inherit.warnings.grep(*.Str.contains('invariant zero')),
    'omission draws no warning: the obligation is inherited';
like $inherit.invariant-zero-status, /'inherited from SPOZ2 0.0'/,
    'status reports the inherited binding';
like $inherit.invariant-zero-status, /'still binding'/,
    'status says omission does not remove the obligation';

# --- canonical-text verification -----------------------------------------
my $match = SPOZ2::Document.parse("SPOZ2 0.0\n\n$g\ninvariants:\n    - " ~ INVARIANT-ZERO ~ "\n");
nok $match.warnings, 'the canonical text repeated verbatim draws no warning';
like $match.invariant-zero-status, /'matches the canonical SPOZ2 0.0 text'/,
    'status reports a verified local match';
like INVARIANT-ZERO, /^ 'Invariant 0.0: humans first.' /,
    'the canonical headline is HUMANS FIRST under the 0.0 designation';

my $drift = SPOZ2::Document.parse("SPOZ2 0.0\n\n$g\ninvariants:\n    - Invariant 0.0: humans first. But reworded weakly.\n");
ok $drift.warnings.grep(*.Str.contains('differs from the canonical')),
    'a reworded invariant zero is flagged as differing from canonical';
like $drift.invariant-zero-status, /'binds regardless'/,
    'status says the canonical text binds despite local drift';

# legacy designation is still recognised as invariant zero (and flagged)
my $legacy = SPOZ2::Document.parse("SPOZ2 0.0\n\n$g\ninvariants:\n    - Invariant zero: humans come first. Old spelling.\n");
ok $legacy.warnings.grep(*.Str.contains('differs from the canonical')),
    'the legacy Invariant zero designation is recognised and flagged';

# --- the published digest matches the canonical bytes --------------------
my $proc = run 'sha256sum', :in, :out;
$proc.in.print(INVARIANT-ZERO);
$proc.in.close;
is $proc.out.slurp(:close).words.head, INVARIANT-ZERO-DIGEST,
    'the published digest matches the canonical text bytes';

# --- unknown version: no false binding claim -----------------------------
my $unknown = SPOZ2::Document.parse("SPOZ2 9.9\n\n$g\ninvariants:\n    - x\n");
like $unknown.invariant-zero-status, /'not established'/,
    'an unknown format version never claims a verified binding';

done-testing;
