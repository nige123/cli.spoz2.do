#!/usr/bin/env raku
# spoz2 — maintain the SPOZ2 (what this project is supposed to do) beside your source.

use lib $*PROGRAM.resolve.parent(2).add('lib').Str;   # run from a checkout without installing
use SPOZ2;
use SPOZ2::Document;
use SPOZ2::Register;

my %*SUB-MAIN-OPTS = :named-anywhere;

sub USAGE() {
    print q:to/END/;
    Usage:
      spoz2 init [--/agent]              create a SPOZ2 here: an agent command
                                           (SPOZ2_AGENT_CMD, default 'claude -p')
                                           drafts it from the codebase's own
                                           account of itself; --/agent, or no
                                           working agent, writes the scaffold
      spoz2 show [FILE] [SECTION]        print the SPOZ2, or one section
      spoz2 check [FILE]                 validate structure (exit 1 on errors)
      spoz2 add KIND TEXT [--file=FILE]  add an entry; KIND is one of
                                           gist behaviour invariant constraint decision
                                           direction reference
                                           (gist needs --replace once set)
      spoz2 log [FILE]                   Git history of the SPOZ2
      spoz2 diff [FILE] [REV [REV]]      Git diff of the SPOZ2
      spoz2 register [--url=U|--token=T] connect this SPOZ2 to the SPOZ2 register
                                           so it is discoverable (sign up first:
                                           register.spoz2.do); no options shows
                                           the connection status or the steps
      spoz2 report [--dry-run|--strict]  submit evidence (presence, digest,
                                           counts, check outcome - never the
                                           text); advisory: exit 0 unless --strict

    FILE is an explicit .spoz2 document; otherwise the nearest SPOZ2 in this
    directory or its parents is used.
    END
}

# Run a command body; user errors become one-line messages and exit 1.
sub attempt(&body) {
    my $rc = body() // 0;
    exit $rc;
    CATCH {
        when X::SPOZ2 { note .message; exit 1 }
    }
}

multi MAIN('init', Bool :$agent = True) {
    attempt {
        user-error("SPOZ2 already exists here; not overwriting") if $*CWD.add('SPOZ2').e;
        my $text;
        if $agent {
            for 1, 2 -> $attempt {
                $text = try agent-init-draft($*CWD);
                last with $text;
                note "agent draft attempt $attempt failed: {$!.message.lines.head}";
            }
            note "falling back to the plain scaffold - distill it by hand, or delete SPOZ2 and rerun spoz2 init"
                without $text;
        }
        with $text {
            my $path = $*CWD.add('SPOZ2');
            $path.spurt($text);
            my $invariants = check-doc($path).section('invariants').items.elems;
            say "Created {$path.basename} ($invariants invariants, agent-drafted)";
            note "review it - the draft states intent, and only the maintainer knows intent.";
        }
        else {
            my $path = init();
            say "Created {$path.basename}";
        }
        0;
    }
}

multi MAIN('show', Str $a?, Str $b?) {
    attempt {
        my ($file, $section) = $a.defined && looks-like-file($a) ?? ($a, $b) !! (Str, $a);
        user-error("too many arguments") if $b.defined && !$file.defined;
        print show-text(resolve-target($file), $section);
        0;
    }
}

multi MAIN('check', Str $file?) {
    attempt {
        my $path = resolve-target($file);
        my $name = display-name($path);
        my $doc  = check-doc($path);
        .say for $doc.report(:$name);
        say $doc.invariant-zero-status;
        say 'checked: structure and the invariant-zero binding only; a '
          ~ 'passing check never means the software is safe, harmless, or '
          ~ 'that its claims are true';
        if $doc.ok { say "OK $name"; 0 } else { 1 }
    }
}

multi MAIN('add', Str $kind, Str $text, Str :$file, Bool :$replace = False) {
    attempt {
        my $section = add-entry(resolve-target($file), $kind, $text, :$replace);
        say $kind eq 'gist' ?? 'Set gist.' !! "Added $kind.";
        0;
    }
}

multi MAIN('log', Str $file?) {
    attempt {
        print log-text(resolve-target($file));
        0;
    }
}

multi MAIN('diff', *@args) {
    attempt {
        my $file = @args && looks-like-file(@args[0]) ?? @args.shift !! Str;
        user-error("diff takes at most two revisions") if @args > 2;
        my ($rc, $out, $err) = diff-result(resolve-target($file), |@args);
        if $rc == 127 { say $err.trim; return 0 }      # no Git: informational, like log
        print $out;
        note $err.trim if $err.trim ne '';
        $rc;
    }
}

multi MAIN('register', Str :$url, Str :$token, Str :$file) {
    attempt {
        my $path = resolve-target($file);
        my $name = display-name($path);
        with $url {
            my $f = save-register-url($path, $url);
            say "Register URL saved to {display-name($f)}";
        }
        with $token {
            my $u = register-url($path)
                // user-error("save the reports URL first: spoz2 register --url=<reports URL>");
            save-token($u, $token);
            say "Token saved to {token-store()} - outside the repository; do not commit it.";
        }
        if !$url.defined && !$token.defined {
            with register-url($path) -> $u {
                say "$name reports to $u";
                say token-for($u).defined
                    ?? "A reporting token is available. Submit evidence with: spoz2 report"
                    !! "No reporting token yet. Mint one on the project's Connect CI page, then:\n  spoz2 register --token=<token>";
            }
            else {
                print qq:to/END/;
                $name is not connected to a register yet.

                To make it discoverable on the SPOZ2 register:
                  1. Sign up first (email passcode): {REGISTER-START}
                  2. Create a project there and mint a reporting token (shown once)
                  3. Connect this SPOZ2:
                       spoz2 register --url=<the project's reports URL>
                       spoz2 register --token=<the token>
                  4. Submit evidence: spoz2 report

                A report carries presence, digest, counts and check outcomes -
                never the text of your SPOZ2. Only register and report talk to
                the network; every other spoz2 command stays offline.
                END
            }
        }
        0;
    }
}

multi MAIN('report', Str :$file, Str :$release, Str :$run-id,
           Bool :$dry-run = False, Bool :$strict = False) {
    attempt {
        my $path   = resolve-target($file);
        my %report = collect-report($path, :$release, :$run-id);
        my $body   = json-encode(%report);
        if $dry-run { say $body; return 0 }

        my $url = register-url($path)
            // user-error("not connected to a register; run 'spoz2 register' for the steps");
        my $token = token-for($url)
            // user-error("no reporting token; run 'spoz2 register' for the steps");

        my ($code, $reply) = submit-report($url, $token, $body);
        if 200 <= $code < 300 {
            say "submitted {%report<report_id>} ({display-name($path)} at {%report<revision>.substr(0, 12)})";
            return 0;
        }
        note $code == 0
            ?? "register unreachable: $reply"
            !! "register answered $code: {$reply.substr(0, 300)}";
        $strict ?? 1 !! 0;   # advisory by design: never blocks a pipeline
    }
}

sub user-error(Str $message) { X::SPOZ2.new(:$message).throw }
