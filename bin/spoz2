#!/usr/bin/env raku
use lib $*PROGRAM.parent(2).add('lib').Str;
use SPOZ2;
use SPOZ2::Model;

# allow flags after the subcommand, e.g. spoz2 add --agent FILE ...
my %*SUB-MAIN-OPTS = :named-anywhere;

#| Parse a .spoz2 file and report what it contains.
multi MAIN('check', Str $file) {
    my $spec = parse-spoz2-file($file);
    say "system {$spec.system.name} (spoz2 {$spec.format})";
    say "  {$spec.entries.elems} invariant entries, {$spec.names.elems} names";
    say "  versions: {$spec.versions.join(', ')}";
    my @p = $spec.problems;
    if @p {
        note "problem: $_" for @p;
        exit 1;
    }
    say "ok";
}

#| List the invariants that apply to a given version.
multi MAIN('at', Str $file, Str $version) {
    show-governing(parse-spoz2-file($file), Version.new($version));
}

#| What the software is supposed to be doing NOW: the invariants that
#| govern the current version, resolved without the file saying so —
#| from the argument ('today' for date-versioned specs), or detected
#| from the file's directory (package metadata / git tags).
multi MAIN('now', Str $file, Str $current?) {
    show-governing(parse-spoz2-file($file),
                   Version.new(resolve-current($file, $current)));
}

sub show-governing($spec, Version $v) {
    say "{$spec.system.name} $v";
    for $spec.invariants-at($v) -> $inv {
        say "";
        say "invariant {$inv.name}  ({$inv.range-str})";
        say $inv.text.indent(2);
    }
}

#| The asker's vantage point.  Deliberately NOT stored in the .spoz2:
#| one spec can govern implementations at different versions, and the
#| implementation's own metadata is the single source of truth.
sub resolve-current(Str $file, $current) {
    given $current {
        when 'today'  { Date.today.Str.subst('-', '.', :g) }
        when .defined { $_ }
        default {
            detect-version($file.IO.parent)
                // die "spoz2: cannot detect the current version from {$file.IO.parent} — pass a version, or 'today' for date-versioned specs"
        }
    }
}

#| Add a new invariant entry.  Same name + later since supersedes the
#| old entry; the old entry stays.  Prose comes from the arguments, or
#| from stdin when none are given.
multi MAIN('add', Str $file, Str $name, Str $since, *@prose) {
    my $prose = @prose ?? @prose.join(' ') !! $*IN.slurp;
    my $new-text = add-invariant($file.IO.slurp, :$name, :$since, :$prose);
    $file.IO.spurt($new-text);

    my @h = parse-spoz2($new-text).history($name);
    if @h > 1 and @h.tail.since != Version.new($since) {
        note "note: '$name' has a later entry (since {@h.tail.since}) — this one is historical backfill";
    }
    say "added invariant $name since $since to $file"
      ~ (@h > 1 ?? " (entry {@h.elems} for this name)" !! "");
}

#| Agent-assisted add: describe the change of intent in plain words and
#| an LLM drafts the entry — name (supersede or new), since, prose.
#| The draft goes through the same validated add as a hand-written one,
#| so the agent cannot produce a malformed entry or rewrite history.
multi MAIN('add', Str $file, *@description, Bool :$agent!) {
    my $description = @description ?? @description.join(' ') !! $*IN.slurp;
    die "spoz2 add --agent: describe the change of intent" unless $description.trim;

    my $prompt = q:to/END/ ~ "\n---\n{$file.IO.slurp}---\n\nThe change of intent, in the maintainer's words:\n$description\n";
        You are updating a SPOZ2 specification file.  A SPOZ2 file records what
        a system is supposed to do, as named invariants bound to version
        ranges.  History is append-only: a change of intent becomes a NEW
        entry.  Reuse an existing invariant name if this changes an existing
        rule (a later "since" supersedes it); invent a new kebab-case name for
        a brand-new rule.  The prose must state the whole rule as it now
        stands (self-contained, not a diff), in the same voice as the file,
        with a short why when the maintainer gives one.  If the maintainer
        does not say which version the change starts at, choose the most
        plausible next version given those already in the file.

        Reply with EXACTLY this shape and nothing else:
        name: <invariant-name>
        since: <version>
        prose: <first line of prose>
        <further lines of prose, if any>

        The current file:
        END

    my $cmd = %*ENV<SPOZ2_AGENT_CMD> // 'claude -p';
    note "asking agent ($cmd) to draft the entry ...";
    my $proc = run '/bin/sh', '-c', $cmd, :in, :out;
    $proc.in.print($prompt);
    $proc.in.close;
    my $reply = $proc.out.slurp;
    die "spoz2 add --agent: agent command failed ($cmd)" if $proc.exitcode != 0;

    my %entry = parse-agent-entry($reply);
    my $new-text = add-invariant($file.IO.slurp, |%entry);
    $file.IO.spurt($new-text);

    say "added invariant %entry<name> since %entry<since> to $file (agent-drafted):";
    say '';
    say "invariant %entry<name>";
    say "  since %entry<since>";
    print %entry<prose>.lines.map({ "  $_\n" }).join;
}

#| Retire an invariant: its latest entry gains `until` and, when given,
#| the reason appended as prose.  The rule then governs no version at or
#| after UNTIL.  The old entry otherwise stays untouched.
multi MAIN('retire', Str $file, Str $name, Str $until, *@reason) {
    my $new-text = retire-invariant($file.IO.slurp, :$name, :$until,
                                    reason => @reason.join(' '));
    $file.IO.spurt($new-text);
    say "retired invariant $name at $until in $file";
}

#| What changed in intent between two versions.
multi MAIN('diff', Str $file, Str $v1, Str $v2) {
    my $spec = parse-spoz2-file($file);
    my %c = $spec.changes(Version.new($v1), Version.new($v2));
    say "{$spec.system.name}: intent changes $v1 -> $v2";
    for %c<added>.list -> $i {
        say "\nnew: invariant {$i.name}  ({$i.range-str})";
        say $i.text.indent(2);
    }
    for %c<retired>.list -> $i {
        say "\nretired: invariant {$i.name}  (was {$i.range-str})";
        say $i.text.indent(2);
    }
    for %c<changed>.list -> ($was, $now) {
        say "\nchanged: invariant {$now.name}  (since {$now.since})";
        say "  was ({$was.range-str}):";
        say $was.text.indent(4);
        say "  now ({$now.range-str}):";
        say $now.text.indent(4);
    }
    say "\nunchanged: {%c<same>.join(', ')}" if %c<same>;
    say "\nno intent changes" unless %c<added> or %c<retired> or %c<changed>;
}

#| Create DIR/<name>.spoz2 and make it REAL: by default an LLM reads
#| the codebase's own account of itself (README, changelog, file
#| layout) and writes the first spec — system prose plus starter
#| invariants — validated before it lands, reviewed by the maintainer,
#| because only they know intent.  A transient agent failure is retried
#| once; if the agent cannot be reached at all, the plain TODO scaffold
#| is written instead (loudly), so init always leaves a valid file.
#| --/agent skips the LLM and writes just the scaffold.
multi MAIN('init', Str $dir = '.', Bool :$agent = True) {
    die "spoz2 init: '$dir' is not a directory" unless $dir.IO.d;
    my $name    = $dir.IO.absolute.IO.basename;
    my $version = detect-version($dir.IO) // '0.1';
    my $target  = $dir.IO.add(sanitise-system-name($name) ~ '.spoz2');
    die "spoz2 init: $target already exists" if $target.e;

    my $text;
    if $agent {
        for 1, 2 -> $attempt {
            $text = try agent-init-draft($dir.IO, :$name, :$version);
            last with $text;
            note "agent draft attempt $attempt failed: {$!.message.lines.head}";
        }
        note "falling back to the plain scaffold — distill it by hand, or delete the file and rerun spoz2 init"
            without $text;
    }
    with $text {
        $target.spurt($text);
        say "created $target (version $version, {parse-spoz2($text).entries.elems} invariants, agent-drafted)";
        note "review it — the draft states intent, and only the maintainer knows intent.";
    }
    else {
        $target.spurt(init-scaffold(:$name, :$version));
        say "created $target (version $version, scaffold only)";
        note "next: an agent or human reads the code and writes the invariants.";
    }
}

#| One agent attempt: prompt from scaffold + bounded evidence, reply
#| validated (parses, no problems, at least one invariant) or we die.
sub agent-init-draft(IO::Path $dir, Str :$name!, Str :$version! --> Str) {
    my $prompt = qq:to/END/ ~ init-scaffold(:$name, :$version) ~ "\nEvidence from the codebase:\n" ~ gather-context($dir);
        Complete the SPOZ2 scaffold below into the first real specification
        for the codebase whose evidence follows it.  Keep the format line
        and the conventions comment.  Replace the TODO system prose with
        what the system is FOR, in a few plain sentences.  Then write 3 to
        7 invariants, each "since $version": the rules someone would be
        upset to see silently broken, as self-contained prose.  State
        intent (what must hold, and why when the evidence says), never
        implementation detail.  Only state rules the evidence actually
        supports — fewer good invariants beat many guessed ones.  Reply
        with ONLY the completed file content: no fences, no commentary.

        The scaffold:
        END

    my $cmd = %*ENV<SPOZ2_AGENT_CMD> // 'claude -p';
    note "asking agent ($cmd) to distill $dir ...";
    my $proc = run '/bin/sh', '-c', $cmd, :in, :out;
    $proc.in.print($prompt);
    $proc.in.close;
    my $reply = $proc.out.slurp;
    die "agent command failed ($cmd)" if $proc.exitcode != 0;

    # tolerate fences/chatter: the file starts at its format line
    my @lines = $reply.lines.grep({ !.starts-with('```') });
    my $start = @lines.first(*.match(/^ 'spoz2' \h+ \d /), :k)
        // die "no 'spoz2 <version>' format line in the agent reply";
    my $text = @lines[$start .. *].join("\n") ~ "\n";

    my $spec = parse-spoz2($text);
    if $spec.problems -> @p {
        die "draft has problems — { @p.join('; ') }";
    }
    die "draft has no invariants" unless $spec.entries;
    $text;
}

#| Bounded evidence for the distilling agent: the codebase's own account
#| of itself, never the whole tree.
sub gather-context(IO::Path $dir --> Str) {
    my @parts;
    for <README.md README.txt README> -> $f {
        next unless $dir.add($f).e;
        @parts.push: "--- $f (head) ---\n" ~ $dir.add($f).slurp.lines.head(80).join("\n");
        last;
    }
    for <CHANGES.md CHANGELOG.md Changes> -> $f {
        next unless $dir.add($f).e;
        @parts.push: "--- $f (head) ---\n" ~ $dir.add($f).slurp.lines.head(40).join("\n");
        last;
    }
    my $find = run 'find', $dir.Str, '-maxdepth', '3', '-type', 'f',
                   '-not', '-path', '*/.git/*', '-not', '-path', '*/node_modules/*',
                   '-not', '-path', '*/.precomp/*', :out, :err;
    my @files = $find.out.slurp.lines.map(*.subst($dir.Str ~ '/', '')).sort.head(60);
    @parts.push: "--- file layout (up to 60) ---\n" ~ @files.join("\n");
    @parts.join("\n\n");
}

#| Current version of a codebase, from package metadata or git tags.
sub detect-version(IO::Path $dir) {
    for <META6.json package.json> -> $f {
        next unless $dir.add($f).e;
        return ~$0 if $dir.add($f).slurp ~~ / '"version"' \s* ':' \s* '"'? (\d+ [ '.' \d+ ]*) /;
    }
    my $tag = run 'git', '-C', $dir.Str, 'describe', '--tags', '--abbrev=0', :out, :err;
    if $tag.exitcode == 0 {
        my $t = $tag.out.slurp.trim.subst(/^ 'v' /, '');
        return $t if $t ~~ /^ \d+ [ '.' \d+ ]* $/;
    }
    Nil;
}

#| The next stated intent after the current version — the immediate
#| work queue: what to implement toward before anything else.
multi MAIN('next', Str $file, Str $current?) {
    my $spec = parse-spoz2-file($file);
    my $v = Version.new(resolve-current($file, $current));
    my @next = $spec.next-after($v);
    unless @next {
        say "{$spec.system.name}: nothing stated beyond $v — the roadmap is empty";
        exit 0;
    }
    say "{$spec.system.name}: next is {@next.head.since}  (current: $v)";
    for @next -> $i {
        my $kind = $spec.history($i.name).first(*.since < $i.since) ?? 'supersedes' !! 'new';
        say "";
        say "invariant {$i.name}  ($kind)";
        say $i.text.indent(2);
    }
}

#| Future intent: entries stated but not yet governing at the current
#| version — the development spine.  CURRENT is taken from the argument
#| ('today' means today's date, for date-versioned specs), or detected
#| from the file's directory (package metadata / git tags).
multi MAIN('roadmap', Str $file, Str $current?) {
    my $spec = parse-spoz2-file($file);
    my $v = Version.new(resolve-current($file, $current));
    my @up = $spec.upcoming($v);
    say "{$spec.system.name}: roadmap from $v";
    unless @up {
        say "  none — no stated intent beyond $v";
        exit 0;
    }
    my $group = '';
    for @up -> $i {
        if ~$i.since ne $group {
            say "\nfrom {$i.since}:";
            $group = ~$i.since;
        }
        my $kind = $spec.history($i.name).first(*.since < $i.since) ?? 'supersedes' !! 'new';
        say "  invariant {$i.name}  ($kind)";
        say $i.text.indent(4);
    }
}

#| Implement the next stated intent: hand the repo to a coding agent
#| with the spec as authority.  The loop: add a future invariant, then
#| spoz2 implement, review the diff, ship the version — the entry
#| starts governing on its own.
multi MAIN('implement', Str $file, Str $current?) {
    my $dir  = $file.IO.parent.absolute;
    my $spec = parse-spoz2-file($file);
    my $v    = Version.new(resolve-current($file, $current));
    my @next = $spec.next-after($v);
    die "spoz2 implement: nothing stated beyond $v — add a future invariant first:\n  spoz2 add $file NAME SINCE \"the rule as prose\""
        unless @next;
    my $goal = @next.head.since;

    my $prompt = qq:to/END/;
        You are working in the repository at $dir.  The file
        {$file.IO.basename} there is the authoritative statement of
        intended behaviour: treat it as authority over the README, the
        changelog and the current code.  The current version is $v and
        version $goal is being prepared.  Implement the intent that
        governs $goal:
        1. Read {$file.IO.basename}.  The entries with "since $goal" are
           the change; the other governing invariants must keep holding.
        2. Find where the implementation diverges from that intent and
           make the minimal changes to close the gap, plus whatever
           version bookkeeping this project conventionally does.
        3. Run the project's tests; add or update tests for the changed
           behaviour.
        4. Do NOT commit, and do not touch any other repository.
        Report at the end: what diverged, what you changed (files and
        specifics), test results, and any friction where the spec was
        unclear.
        END

    my $cmd = %*ENV<SPOZ2_IMPLEMENT_CMD> // 'claude -p --permission-mode acceptEdits';
    note "handing $dir to the agent ($cmd) to implement $goal ...";
    my $proc = run '/bin/sh', '-c', "cd '$dir' && $cmd", :in, :out;
    $proc.in.print($prompt);
    $proc.in.close;
    say $proc.out.slurp;
    die "spoz2 implement: agent command failed ($cmd)" if $proc.exitcode != 0;
    note "review the working tree in $dir before committing.";
}

#| Check that $new-file only appends to the history in $old-file.
multi MAIN('guard', Str $old-file, Str $new-file) {
    guard(parse-spoz2-file($old-file), parse-spoz2-file($new-file));
}

#| Check the working file against its last committed version (git HEAD).
multi MAIN('guard', Str $file) {
    my $dir  = $file.IO.parent.Str;
    my $show = run 'git', '-C', $dir, 'show', "HEAD:./{$file.IO.basename}", :out, :err;
    my $old-text = $show.out.slurp;
    $show.err.slurp;
    if $show.exitcode != 0 {
        say "nothing committed to guard against — ok";
        exit 0;
    }
    guard(parse-spoz2($old-text), parse-spoz2-file($file));
}

sub guard($old, $new) {
    my @violations = guard-history($old, $new);
    if @violations {
        note "history rewritten: $_" for @violations;
        exit 1;
    }
    my $added = $new.entries.elems - $old.entries.elems;
    say "ok: history preserved ({$old.entries.elems} entries kept, $added added)";
}

#| Show every historical entry for one invariant name.
multi MAIN('history', Str $file, Str $name) {
    my $spec = parse-spoz2-file($file);
    my @h = $spec.history($name);
    note "no invariant named '$name'" and exit 1 unless @h;
    for @h -> $inv {
        say "since {$inv.since}" ~ ($inv.until.defined ?? " until {$inv.until}" !! "");
        say $inv.text.indent(2);
        say "";
    }
}
